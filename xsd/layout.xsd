<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="page" type="layoutUpdateType" />
    <xs:element name="layout" type="layoutUpdateType" />

    <xs:complexType name="layoutUpdateType">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="block" type="blockType" />
            <xs:element name="css" type="cssType" />
            <xs:element name="js" type="jsType" />
            <xs:element name="title" type="titleType" />
            <xs:element name="reference" type="blockType" />
            <xs:element name="include" type="includeType" />
        </xs:choice>
    </xs:complexType>

    <xs:complexType name="blockType">
        <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="block" type="blockType" />
                <xs:element name="variables" type="variablesType" />
                <xs:element name="actions" type="actionsType" />
                <xs:element name="wrapper" type="wrapperType" />
            </xs:choice>
            <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="id" type="xs:string" use="required" />
        <xs:attribute name="template" type="xs:string" />
        <xs:attribute name="captureTo" type="xs:string" />
        <xs:attribute name="parentId" type="xs:string" />
        <xs:attribute name="before" type="xs:string" />
        <xs:attribute name="after" type="xs:string" />
        <xs:attribute name="class" type="xs:string" />
        <xs:attribute name="append" type="xs:boolean" />
        <xs:attribute name="remove" type="xs:boolean" />
        <xs:attribute name="order" type="xs:integer" />
        <xs:anyAttribute processContents="lax" />
    </xs:complexType>

    <xs:complexType name="cssType">
        <xs:attribute name="id" type="xs:string" use="required" />
        <xs:attribute name="src" type="xs:string" />
        <xs:attribute name="href" type="xs:string" />
        <xs:attribute name="remove" type="xs:boolean" />
        <xs:anyAttribute processContents="lax" />
    </xs:complexType>

    <xs:complexType name="jsType">
        <xs:attribute name="id" type="xs:string" use="required" />
        <xs:attribute name="src" type="xs:string" />
        <xs:attribute name="inline" type="xs:boolean" />
        <xs:attribute name="remove" type="xs:boolean" />
        <xs:anyAttribute processContents="lax" />
    </xs:complexType>

    <xs:complexType name="titleType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="id" type="xs:string" use="required" />
                <xs:attribute name="append" type="xs:boolean" />
                <xs:attribute name="set" type="xs:boolean" />
                <xs:attribute name="prepend" type="xs:boolean" />
                <xs:attribute name="remove" type="xs:boolean" />
                <xs:anyAttribute processContents="lax" />
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="variablesType">
        <xs:sequence>
            <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="actionsType">
        <xs:sequence>
            <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="wrapperType">
        <xs:sequence>
            <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="includeType">
        <xs:sequence>
            <xs:any processContents="lax" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="handle" type="xs:string" use="required" />
    </xs:complexType>

</xs:schema>
