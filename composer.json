{
    "name": "hummer2k/conlayout",
    "description": "Mezzio package for handling layouts with blocks and handles similar to magento",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "mezzio",
        "psr-15",
        "laminas",
        "layout",
        "handles",
        "blocks"
    ],
    "authors": [
        {
            "name": "Cornelius Adams",
            "email": "cornelius.adams@conlabz.de",
            "homepage": "http://www.conlabz.de/"
        }
    ],
    "require": {
        "php": "^8.2",
        "laminas/laminas-config": "^3.10",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-eventmanager": "^3.14",
        "laminas/laminas-filter": "^2.42",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stdlib": "^3.20",
        "laminas/laminas-view": "^2.27",
        "mezzio/mezzio": "^3.28",
        "mezzio/mezzio-laminasviewrenderer": "^2.19"
    },
    "suggest": {
        "laminas/laminas-i18n": "Translate filter support"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "laminas/laminas-i18n": "^2.30",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "ConLayout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConLayoutTest\\": "test/"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
