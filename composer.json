{
    "name": "hummer2k/conlayout",
    "description": "Module for handling laminas-mvc layouts with blocks and handles similar to magento",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "zf",
        "zf3",
        "laminas",
        "layout",
        "handles",
        "blocks"
    ],
    "authors": [
        {
            "name": "Cornelius Adams",
            "email": "cornelius.adams@conlabz.de",
            "homepage": "http://www.conlabz.de/"
        }
    ],
    "require": {
        "php": "^8.2",
        "laminas/laminas-config": "^3.10",
        "laminas/laminas-eventmanager": "^3.14",
        "laminas/laminas-http": "^2.22",
        "laminas/laminas-modulemanager": "^2.18",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-router": "^3.16",
        "laminas/laminas-servicemanager": "^3.20",
        "laminas/laminas-stdlib": "^3.20",
        "laminas/laminas-view": "^2.25"
    },
    "suggest": {
        "laminas/laminas-filter": "Filter configured params e.g. src, href attributes (basepath, cachebuster, ...)"
    },
    "require-dev": {
        "laminas/laminas-developer-tools": "^2.10",
        "laminas/laminas-filter": "^2.42",
        "laminas/laminas-i18n": "^2.15",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "ConLayout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConLayoutTest\\": "test/"
        }
    },
    "extra": {
        "zf": {
            "component": "ConLayout"
        }
    }
}
