{
    "name": "hummer2k/conlayout",
    "description": "Mezzio package for handling layouts with blocks and handles similar to magento",
    "license": "MIT",
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "keywords": [
        "mezzio",
        "psr-15",
        "laminas",
        "layout",
        "handles",
        "blocks"
    ],
    "authors": [
        {
            "name": "Cornelius Adams",
            "email": "cornelius.adams@conlabz.de",
            "homepage": "http://www.conlabz.de/"
        }
    ],
    "require": {
        "php": "^8.3",
        "laminas/laminas-config": "^3.10",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-eventmanager": "^3.14",
        "laminas/laminas-filter": "^3.4",
        "laminas/laminas-servicemanager": "^4.4",
        "laminas/laminas-stdlib": "^3.20",
        "laminas/laminas-view": "^3.0.1",
        "mezzio/mezzio": "^3.28",
        "mezzio/mezzio-laminasviewrenderer": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6",
        "vimeo/psalm": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "ConLayout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ConLayoutTest\\": "test/"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "psalm": "psalm"
    }
}
